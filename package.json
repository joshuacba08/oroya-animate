{
  "name": "oroya-animate-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo for Oroya Animate, a 2D/3D web graphics library",
  "author": "Oroya AI Collaborator",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter \"./packages/**\" build",
    "build:web": "pnpm build && pnpm --filter \"web\" build",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"packages/*/src/**/*.{ts,tsx}\" --fix",
    "api:check": "node scripts/api-check.js",
    "dev:vanilla": "pnpm --filter \"demo-vanilla\" dev",
    "dev:react": "pnpm --filter \"demo-react\" dev",
    "dev:web": "pnpm --filter \"web\" dev",
    "clean": "pnpm -r exec rm -rf dist .turbo",
    "typecheck": "pnpm -r typecheck",
    "sync-versions": "node scripts/sync-versions.js",
    "publish:packages": "pnpm build && pnpm --filter \"./packages/**\" publish --access public",
    "deploy:web": "pnpm build:web && vercel --prod"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "eslint": "^9.0.0",
    "glob": "^10.3.10",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.6.0"
  },
  "packageManager": "pnpm@9.1.0"
}