{
  "name": "oroya-animate-monorepo",
  "private": true,
  "version": "1.3.0",
  "description": "Monorepo for Oroya Animate, a 2D/3D web graphics library",
  "author": "Oroya AI Collaborator",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter \"./packages/**\" build",
    "build:web": "pnpm docs:check && pnpm build && pnpm --filter \"web\" build",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\" \"apps/*/src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"packages/*/src/**/*.{ts,tsx}\" \"apps/*/src/**/*.{ts,tsx}\" --fix",
    "api:check": "node scripts/api-check.js",
    "docs:sync": "node scripts/sync-docs.js",
    "docs:check": "node scripts/sync-docs.js --check",
    "dev:vanilla": "pnpm --filter \"demo-vanilla\" dev",
    "dev:react": "pnpm --filter \"demo-react\" dev",
    "dev:web": "pnpm --filter \"web\" dev",
    "clean": "pnpm -r exec rm -rf dist .turbo",
    "typecheck": "pnpm -r typecheck",
    "sync-versions": "node scripts/sync-versions.js",
    "publish:packages": "node scripts/publish-release.js",
    "deploy:web": "gh workflow run deploy-web.yml --ref main",
    "api:check:strict": "node scripts/api-check.js --strict",
    "typecheck:packages": "pnpm --filter \"./packages/**\" typecheck",
    "typecheck:apps": "pnpm --filter \"./apps/**\" typecheck",
    "docs:validate": "node scripts/check-docs.js",
    "test:browser": "playwright test",
    "build:apps": "pnpm --filter \"./apps/**\" build",
    "lint:packages": "eslint \"packages/*/src/**/*.{ts,tsx}\"",
    "lint:apps": "eslint \"apps/*/src/**/*.{ts,tsx}\"",
    "architecture:check": "node scripts/architecture-check.js",
    "api:compat": "node scripts/api-compatibility.js",
    "test:endurance": "node scripts/runtime-budget.js --endurance",
    "perf:record": "node scripts/runtime-budget.js --record",
    "perf:check": "node scripts/runtime-budget.js",
    "verify:packages": "node scripts/verify-packages.js",
    "release:check": "node scripts/release-check.js",
    "publish:release": "node scripts/publish-release.js"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/jsdom": "21.1.7",
    "@types/node": "^20.14.2",
    "eslint": "^9.0.0",
    "glob": "^10.3.10",
    "jsdom": "24.1.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.6.0"
  },
  "packageManager": "pnpm@9.1.0"
}
