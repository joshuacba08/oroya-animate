{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "DOM"],
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@joroya/assets": ["packages/assets/src/index.ts"],
      "@joroya/assets/*": ["packages/assets/src/*"],
      "@joroya/core": ["packages/core/src/index.ts"],
      "@joroya/core/*": ["packages/core/src/*"],
      "@joroya/input": ["packages/input/src/index.ts"],
      "@joroya/input/*": ["packages/input/src/*"],
      "@joroya/inspector": ["packages/inspector/src/index.ts"],
      "@joroya/inspector/*": ["packages/inspector/src/*"],
      "@joroya/loader-gltf": ["packages/loader-gltf/src/index.ts"],
      "@joroya/loader-gltf/*": ["packages/loader-gltf/src/*"],
      "@joroya/physics": ["packages/physics/src/index.ts"],
      "@joroya/physics/*": ["packages/physics/src/*"],
      "@joroya/react": ["packages/react/src/index.ts"],
      "@joroya/react/*": ["packages/react/src/*"],
      "@joroya/renderer-canvas2d": ["packages/renderer-canvas2d/src/index.ts"],
      "@joroya/renderer-canvas2d/*": ["packages/renderer-canvas2d/src/*"],
      "@joroya/renderer-svg": ["packages/renderer-svg/src/index.ts"],
      "@joroya/renderer-svg/*": ["packages/renderer-svg/src/*"],
      "@joroya/renderer-three": ["packages/renderer-three/src/index.ts"],
      "@joroya/renderer-three/*": ["packages/renderer-three/src/*"],
      "@joroya/vue": ["packages/vue/src/index.ts"],
      "@joroya/vue/*": ["packages/vue/src/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "exclude": ["node_modules", "dist"]
}
