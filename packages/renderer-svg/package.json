{
  "name": "@joroya/renderer-svg",
  "version": "0.9.0",
  "description": "Lightweight SVG renderer for Oroya Animate scene graphs",
  "keywords": [
    "oroya",
    "svg",
    "2d",
    "renderer",
    "graphics",
    "vector",
    "typescript",
    "generative-art"
  ],
  "author": {
    "name": "Oroya AI Collaborator",
    "url": "https://github.com/joshuacba08"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joshuacba08/oroya-animate.git",
    "directory": "packages/renderer-svg"
  },
  "homepage": "https://oroya-animate.vercel.app",
  "bugs": {
    "url": "https://github.com/joshuacba08/oroya-animate/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@joroya/core": "^0.3.0"
  },
  "dependencies": {
    "@joroya/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.1.0",
    "typescript": "^5.4.5"
  }
}
