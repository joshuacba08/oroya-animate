{
  "name": "@joroya/assets",
  "version": "1.0.2",
  "description": "Centralized asset cache with preloading, ref-counting, and progress events for Oroya Animate",
  "keywords": [
    "oroya",
    "assets",
    "asset-manager",
    "preloader",
    "cache"
  ],
  "author": {
    "name": "Oroya AI Collaborator",
    "url": "https://github.com/joshuacba08"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joshuacba08/oroya-animate.git",
    "directory": "packages/assets"
  },
  "homepage": "https://oroya-animate.vercel.app",
  "bugs": {
    "url": "https://github.com/joshuacba08/oroya-animate/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@joroya/core": "^1.0.0"
  },
  "dependencies": {
    "@joroya/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.1.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false
}
