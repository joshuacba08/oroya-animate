{
  "name": "@joroya/loader-gltf",
  "version": "0.8.0",
  "description": "glTF/GLB 3D model loader for Oroya Animate scene graphs",
  "keywords": [
    "oroya",
    "gltf",
    "glb",
    "3d",
    "loader",
    "model",
    "import",
    "three",
    "typescript"
  ],
  "author": {
    "name": "Oroya AI Collaborator",
    "url": "https://github.com/joshuacba08"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joshuacba08/oroya-animate.git",
    "directory": "packages/loader-gltf"
  },
  "homepage": "https://oroya-animate.vercel.app",
  "bugs": {
    "url": "https://github.com/joshuacba08/oroya-animate/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@joroya/core": "^0.3.0",
    "three": "^0.165.0"
  },
  "dependencies": {
    "@joroya/core": "workspace:*",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@types/three": "^0.165.0",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5"
  }
}
