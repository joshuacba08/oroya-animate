---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import { PhysicsLearnLab } from "../../../components/learn/PhysicsLearnLab";
import { getLocaleFromUrl, useTranslations } from "../../../i18n";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<Layout title={`${t('learn.title')} — Oroya Animate`} description={t('learn.description')}>
  <Navbar />
  <main id="main-content" class="pt-24 pb-16 px-4 lg:px-8">
    <PhysicsLearnLab client:load locale={locale} />
  </main>
  <Footer />
</Layout>
