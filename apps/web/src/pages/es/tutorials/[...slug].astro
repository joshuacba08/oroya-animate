---
import DocsLayout from "../../../layouts/DocsLayout.astro";
import TutorialDemo from "../../../components/TutorialDemo";
import { getCollection, render } from "astro:content";
import { getLocaleFromUrl, useTranslations, getLocalizedPath } from "../../../i18n";

export async function getStaticPaths() {
  // Build paths from the default tutorials collection so every tutorial
  // has a Spanish route, then we prefer a translated body if it exists.
  const tutorials = await getCollection("tutorials");
  const localized = await getCollection("tutorials-es");
  const localizedById = new Map(localized.map((e) => [e.id, e]));
  return tutorials.map((entry) => ({
    params: { slug: entry.id },
    props: { entry: localizedById.get(entry.id) ?? entry, isFallback: !localizedById.has(entry.id) },
  }));
}

const { entry, isFallback } = Astro.props;
const { Content } = await render(entry);

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const allTutorials = await getCollection("tutorials");
const sorted = allTutorials.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const currentIndex = sorted.findIndex((t) => t.id === entry.id);
const prevTutorial = currentIndex > 0 ? sorted[currentIndex - 1] : null;
const nextTutorial = currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null;

const levelBadge = {
  beginner: { class: "badge-success", label: t('tutorials.beginner') },
  intermediate: { class: "badge-warning", label: t('tutorials.intermediate') },
  advanced: { class: "badge-error", label: t('tutorials.advanced') },
};
const badge = levelBadge[entry.data.level ?? "beginner"];

const totalTutorials = sorted.length;
const currentNumber = currentIndex + 1;
---

<DocsLayout title={entry.data.title} description={entry.data.description}>
  {isFallback && (
    <div class="alert alert-info mb-8">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <span>{t('i18n.translationPending')}</span>
    </div>
  )}

  <div class="not-prose mb-8">
    <div class="flex flex-wrap items-center gap-3 mb-4">
      <span class={`badge ${badge.class} badge-sm`}>{badge.label}</span>
      {entry.data.duration && (
        <span class="text-sm text-base-content/50 font-mono flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          {entry.data.duration}
        </span>
      )}
      <span class="text-xs text-base-content/30 font-mono ml-auto">
        {currentNumber} / {totalTutorials}
      </span>
    </div>

    <div class="tutorial-player-section mb-8" id="tutorial-demo">
      <div class="tutorial-demo-label flex items-center gap-2 mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
          <polygon points="5 3 19 12 5 21 5 3"/>
        </svg>
        <span class="text-sm font-display font-semibold text-base-content/70">{t('tutorials.liveDemo')}</span>
      </div>
      <TutorialDemo client:only="react" tutorialId={entry.id} />
    </div>

  </div>

  <nav class="tutorial-step-nav not-prose" id="step-nav" aria-label="Tutorial steps">
    <div class="tutorial-step-nav-inner" id="step-nav-inner"></div>
  </nav>

  <div id="tutorial-content">
    <Content />
  </div>

  <div slot="pagination" class="flex justify-between gap-4">
    {prevTutorial ? (
      <a
        href={getLocalizedPath(`/tutorials/${prevTutorial.id}`, locale)}
        class="glass-card rounded-xl p-4 flex-1 group no-underline max-w-[50%]"
      >
        <span class="text-xs text-base-content/40 font-display">{t('tutorials.previous')}</span>
        <p class="text-sm font-display font-semibold text-base-content/80 group-hover:text-primary transition-colors mt-1">
          ← {prevTutorial.data.title}
        </p>
      </a>
    ) : <div />}

    {nextTutorial ? (
      <a
        href={getLocalizedPath(`/tutorials/${nextTutorial.id}`, locale)}
        class="glass-card rounded-xl p-4 flex-1 group no-underline text-right max-w-[50%]"
      >
        <span class="text-xs text-base-content/40 font-display">{t('tutorials.next')}</span>
        <p class="text-sm font-display font-semibold text-base-content/80 group-hover:text-primary transition-colors mt-1">
          {nextTutorial.data.title} →
        </p>
      </a>
    ) : <div />}
  </div>
</DocsLayout>

<script>
  function initStepNav() {
    const content = document.getElementById("tutorial-content");
    const navInner = document.getElementById("step-nav-inner");
    if (!content || !navInner) return;

    const headings = content.querySelectorAll("h2");
    if (headings.length === 0) {
      const nav = document.getElementById("step-nav");
      if (nav) nav.style.display = "none";
      return;
    }

    headings.forEach((h, i) => { if (!h.id) h.id = `step-${i}`; });

    navInner.innerHTML = "";
    headings.forEach((h, i) => {
      const btn = document.createElement("button");
      btn.className = "tutorial-step-btn";
      btn.dataset.index = String(i);

      const num = document.createElement("span");
      num.className = "tutorial-step-num";
      num.textContent = String(i + 1);

      const label = document.createElement("span");
      label.className = "tutorial-step-label";
      label.textContent = h.textContent?.replace(/^#+\s*/, "") || `Paso ${i + 1}`;

      btn.appendChild(num);
      btn.appendChild(label);
      navInner.appendChild(btn);
      btn.addEventListener("click", () => { h.scrollIntoView({ behavior: "smooth", block: "start" }); });
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const idx = Array.from(headings).indexOf(entry.target as HTMLHeadingElement);
            if (idx !== -1) updateActiveStep(idx);
          }
        });
      },
      { rootMargin: "-80px 0px -60% 0px", threshold: 0 }
    );
    headings.forEach((h) => observer.observe(h));

    function updateActiveStep(index: number) {
      const buttons = navInner!.querySelectorAll(".tutorial-step-btn");
      buttons.forEach((btn, i) => {
        btn.classList.toggle("active", i === index);
        btn.classList.toggle("completed", i < index);
      });
      const activeBtn = buttons[index] as HTMLElement;
      if (activeBtn) activeBtn.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
    }

    updateActiveStep(0);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initStepNav);
  } else {
    initStepNav();
  }
</script>
