---
import { getLocaleFromUrl, useTranslations } from '../i18n';
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const features = [
  {
    icon: `<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>`,
    title: t('features.engineAgnostic'),
    description: t('features.engineAgnosticDesc'),
  },
  {
    icon: `<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg>`,
    title: t('features.typescriptFirst'),
    description: t('features.typescriptFirstDesc'),
  },
  {
    icon: `<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><path d="M20.2 20.2c2.04-2.03.02-7.36-4.5-11.9-4.54-4.52-9.87-6.54-11.9-4.5-2.04 2.03-.02 7.36 4.5 11.9 4.54 4.52 9.87 6.54 11.9 4.5Z"/><path d="M15.7 15.7c4.52-4.54 6.54-9.87 4.5-11.9-2.03-2.04-7.36-.02-11.9 4.5-4.52 4.54-6.54 9.87-4.5 11.9 2.03 2.04 7.36.02 11.9-4.5Z"/></svg>`,
    title: t('features.sceneGraph'),
    description: t('features.sceneGraphDesc'),
  },
  {
    icon: `<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m2 12 5.1 2.9L12 12l-2-5.1L2 12z"/><path d="m12 12 4.9 2.9L22 12l-5.1-2.9L12 12z"/><path d="M7.1 14.9 12 22l4.9-7.1"/><path d="M12 2 7.1 9.1 12 12l4.9-2.9L12 2z"/></svg>`,
    title: t('features.physicsAnimation'),
    description: t('features.physicsAnimationDesc'),
    badge: t('features.badgeV1'),
  },
  {
    icon: `<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M14 15H9v-5"/><path d="M16 3h5v5"/><path d="M21 3 9 15"/></svg>`,
    title: t('features.pluginSystem'),
    description: t('features.pluginSystemDesc'),
    badge: t('features.badgeV1'),
  },
  {
    icon: `<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.306 8.711c-2.602.723-1.9 3.906.666 3.906h6.028c2.566 0 3.268-3.183.666-3.906a3.63 3.63 0 0 0-7.36 0z"/><path d="M22 12h-4"/><path d="M6 12H2"/><path d="M12 2v4"/><path d="m19.07 4.93-2.83 2.83"/><path d="m4.93 4.93 2.83 2.83"/><path d="M12 12v10"/></svg>`,
    title: t('features.frameworkBindings'),
    description: t('features.frameworkBindingsDesc'),
    badge: t('features.badgeV1'),
  },
];
---

<section id="features" class="py-24 px-6">
  <div class="container mx-auto max-w-6xl">
    <!-- Section header -->
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold font-display mb-4 tracking-tight" set:html={t('features.sectionTitle')}></h2>
      <p class="text-base-content/60 max-w-xl mx-auto text-lg">
        {t('features.sectionSubtitle')}
      </p>
    </div>

    <!-- Feature cards grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((feature) => (
        <div class="feature-card glass-card rounded-2xl p-6 group relative">
          {feature.badge && (
            <span class="absolute top-3 right-3 badge badge-primary badge-xs font-mono font-bold">
              {feature.badge}
            </span>
          )}
          <div class="text-primary mb-4 group-hover:text-accent transition-colors duration-300" set:html={feature.icon} />
          <h3 class="text-lg font-display font-semibold mb-2">{feature.title}</h3>
          <p class="text-base-content/60 text-sm leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
