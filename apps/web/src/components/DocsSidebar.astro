---
import { getLocaleFromUrl, useTranslations, getLocalizedPath } from '../i18n';

interface SidebarLink {
  slug: string;
  label: string;
}

interface SidebarSection {
  title: string;
  items: SidebarLink[];
  basePath?: string;
}

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const currentPath = Astro.url.pathname;

const docsSections: SidebarSection[] = [
  {
    title: t('docs.gettingStarted'),
    items: [
      { slug: "getting-started", label: t('docs.sidebar.introduction') },
    ],
  },
  {
    title: t('docs.coreConcepts'),
    items: [
      { slug: "architecture", label: t('docs.sidebar.architecture') },
      { slug: "scene-graph", label: t('docs.sidebar.sceneGraph') },
      { slug: "renderers", label: t('docs.sidebar.renderers') },
      { slug: "serialization", label: t('docs.sidebar.serialization') },
    ],
  },
  {
    title: t('docs.reference'),
    items: [
      { slug: "api-reference", label: t('docs.sidebar.apiReference') },
    ],
  },
  {
    title: t('docs.development'),
    items: [
      { slug: "contributing", label: t('docs.sidebar.contributing') },
      { slug: "programming-principles", label: t('docs.sidebar.principles') },
    ],
  },
];

const tutorialSections: SidebarSection[] = [
  {
    title: t('tutorials.beginner'),
    basePath: "/tutorials",
    items: [
      { slug: "01-hello-cube", label: t('tutorials.items.helloCube') },
      { slug: "02-color-palette", label: t('tutorials.items.colorPalette') },
      { slug: "03-save-load-scenes", label: t('tutorials.items.saveLoadScenes') },
    ],
  },
  {
    title: t('tutorials.intermediate'),
    basePath: "/tutorials",
    items: [
      { slug: "04-solar-system", label: t('tutorials.items.solarSystem') },
      { slug: "05-svg-generative-art", label: t('tutorials.items.svgGenerativeArt') },
      { slug: "06-cameras-viewpoints", label: t('tutorials.items.camerasViewpoints') },
      { slug: "09-svg-gradients-filters", label: t('tutorials.items.svgGradientsFilters') },
      { slug: "10-svg-animations", label: t('tutorials.items.svgAnimations') },
    ],
  },
  {
    title: t('tutorials.advanced'),
    basePath: "/tutorials",
    items: [
      { slug: "07-procedural-city", label: t('tutorials.items.proceduralCity') },
      { slug: "08-multi-renderer", label: t('tutorials.items.multiRenderer') },
      { slug: "11-svg-interactive", label: t('tutorials.items.svgInteractive') },
    ],
  },
];

function isActive(slug: string, basePath?: string): boolean {
  const prefix = basePath || "/docs";
  const localizedPrefix = getLocalizedPath(prefix, locale);
  return currentPath === `${localizedPrefix}/${slug}` || currentPath === `${localizedPrefix}/${slug}/`;
}

function renderSections(sections: SidebarSection[], defaultBasePath: string) {
  return sections;
}
---

<aside class="w-72 shrink-0 min-h-full bg-base-100 lg:bg-transparent lg:fixed lg:top-20 lg:bottom-0 lg:left-0 lg:w-72">
  <nav class="max-h-[calc(100vh-6rem)] overflow-y-auto px-4 pb-8 pt-4 lg:pt-0 space-y-6" aria-label={t('docs.navigation')}>
    <!-- Docs sections -->
    <div>
      <a
        href={getLocalizedPath("/docs", locale)}
        class:list={[
          "text-xs font-display font-bold uppercase tracking-wider mb-4 block",
          currentPath === getLocalizedPath("/docs", locale) || currentPath === `${getLocalizedPath("/docs", locale)}/`
            ? "text-primary"
            : "text-base-content/40 hover:text-base-content/70 transition-colors",
        ]}
      >
        {t('docs.sidebar.documentation')}
      </a>
      {docsSections.map((section) => (
        <div class="mb-5">
          <h4 class="text-xs font-display font-semibold uppercase tracking-wider text-base-content/40 mb-2 pl-3">
            {section.title}
          </h4>
          <ul class="space-y-0.5">
            {section.items.map((item) => (
              <li>
                <a
                  href={getLocalizedPath(`/docs/${item.slug}`, locale)}
                  class:list={[
                    "block text-sm py-1.5 px-3 rounded-lg transition-all duration-200",
                    isActive(item.slug)
                      ? "bg-primary/10 text-primary font-medium border-l-2 border-primary"
                      : "text-base-content/60 hover:text-base-content hover:bg-base-200/50",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Divider -->
    <div class="border-t border-base-300/30 my-4"></div>

    <!-- Tutorials sections -->
    <div>
      <a
        href={getLocalizedPath("/tutorials", locale)}
        class:list={[
          "text-xs font-display font-bold uppercase tracking-wider mb-4 block",
          currentPath === getLocalizedPath("/tutorials", locale) || currentPath === `${getLocalizedPath("/tutorials", locale)}/`
            ? "text-primary"
            : "text-base-content/40 hover:text-base-content/70 transition-colors",
        ]}
      >
        {t('docs.sidebar.tutorials')}
      </a>
      {tutorialSections.map((section) => (
        <div class="mb-5">
          <h4 class="text-xs font-display font-semibold uppercase tracking-wider text-base-content/40 mb-2 pl-3 flex items-center gap-2">
            {section.title}
            {section.title === t('tutorials.beginner') && <span class="badge badge-success badge-xs">{t('tutorials.badgeEasy')}</span>}
            {section.title === t('tutorials.intermediate') && <span class="badge badge-warning badge-xs">{t('tutorials.badgeMid')}</span>}
            {section.title === t('tutorials.advanced') && <span class="badge badge-error badge-xs">{t('tutorials.badgeHard')}</span>}
          </h4>
          <ul class="space-y-0.5">
            {section.items.map((item) => (
              <li>
                <a
                  href={getLocalizedPath(`/tutorials/${item.slug}`, locale)}
                  class:list={[
                    "block text-sm py-1.5 px-3 rounded-lg transition-all duration-200",
                    isActive(item.slug, "/tutorials")
                      ? "bg-primary/10 text-primary font-medium border-l-2 border-primary"
                      : "text-base-content/60 hover:text-base-content hover:bg-base-200/50",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </nav>
</aside>
