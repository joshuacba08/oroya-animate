---
import { getLocaleFromUrl, useTranslations } from '../i18n';
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<section id="about" class="py-24 px-6">
  <div class="container mx-auto max-w-4xl">
    <div class="glass-card rounded-3xl p-8 md:p-12 relative overflow-hidden">
      <!-- Background gradient accent -->
      <div class="absolute inset-0 -z-10">
        <div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-accent/8 rounded-full blur-[120px]"></div>
        <div class="absolute top-0 left-0 w-[300px] h-[300px] bg-primary/6 rounded-full blur-[100px]"></div>
      </div>

      <!-- Section header -->
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold font-display mb-4 tracking-tight" set:html={t('about.title')}></h2>
        <p class="text-base-content/60 text-lg max-w-2xl mx-auto">
          {t('about.subtitle')}
        </p>
      </div>

      <!-- Story paragraphs -->
      <div class="space-y-4 text-base-content/70 text-base leading-relaxed max-w-2xl mx-auto mb-10">
        <p>{t('about.paragraph1')}</p>
        <p>{t('about.paragraph2')}</p>
      </div>

      <!-- About the Creator -->
      <div class="border-t border-base-300/30 pt-8">
        <div class="flex flex-col sm:flex-row items-center gap-6">
          <div class="shrink-0">
            <img
              src="https://avatars.githubusercontent.com/u/47667368?v=4"
              alt="Josué Oroya"
              width="64"
              height="64"
              loading="lazy"
              class="w-16 h-16 rounded-full object-cover ring-2 ring-primary/20"
            />
          </div>
          <div class="text-center sm:text-left">
            <h3 class="font-display font-semibold text-lg mb-1">{t('about.creatorHeading')}</h3>
            <p class="text-base-content/60 text-sm leading-relaxed mb-3">
              {t('about.creatorBio')}
            </p>
            <a
              href="https://github.com/joshuacba08"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-accent transition-colors"
            >
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              <span>Josué Oroya</span>
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
