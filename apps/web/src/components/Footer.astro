---
import { getLocaleFromUrl, useTranslations, getLocalizedPath } from '../i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-base-300/50 py-12 px-6 mt-12">
  <div class="container mx-auto max-w-6xl">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="md:col-span-1">
        <a href={getLocalizedPath("/", locale)} class="flex items-center gap-2 text-lg font-display font-bold mb-3">
          <div class="w-7 h-7 rounded-md bg-gradient-to-br from-purple-500 via-blue-500 to-cyan-500 flex items-center justify-center text-white text-xs font-bold">
            O
          </div>
          Oroya Animate
        </a>
        <p class="text-sm text-base-content/50 leading-relaxed">
          {t('footer.tagline')}
        </p>
      </div>

      <!-- Docs -->
      <div>
        <h4 class="font-display font-semibold text-sm mb-3">{t('footer.documentation')}</h4>
        <ul class="space-y-2 text-sm text-base-content/50">
          <li><a href={getLocalizedPath("/docs/getting-started", locale)} class="hover:text-base-content transition-colors">{t('footer.gettingStarted')}</a></li>
          <li><a href={getLocalizedPath("/docs/architecture", locale)} class="hover:text-base-content transition-colors">{t('footer.architecture')}</a></li>
          <li><a href={getLocalizedPath("/docs/api-reference", locale)} class="hover:text-base-content transition-colors">{t('footer.apiReference')}</a></li>
          <li><a href={getLocalizedPath("/docs/tutorials", locale)} class="hover:text-base-content transition-colors">{t('footer.tutorials')}</a></li>
        </ul>
      </div>

      <!-- Packages -->
      <div>
        <h4 class="font-display font-semibold text-sm mb-3">{t('footer.packages')}</h4>
        <ul class="space-y-2 text-sm text-base-content/50">
          <li><a href="https://www.npmjs.com/package/@joroya/core" target="_blank" rel="noopener" class="hover:text-base-content transition-colors font-mono">@joroya/core</a></li>
          <li><a href="https://www.npmjs.com/package/@joroya/renderer-three" target="_blank" rel="noopener" class="hover:text-base-content transition-colors font-mono">@joroya/renderer-three</a></li>
          <li><a href="https://www.npmjs.com/package/@joroya/renderer-svg" target="_blank" rel="noopener" class="hover:text-base-content transition-colors font-mono">@joroya/renderer-svg</a></li>
          <li><a href="https://www.npmjs.com/package/@joroya/loader-gltf" target="_blank" rel="noopener" class="hover:text-base-content transition-colors font-mono">@joroya/loader-gltf</a></li>
        </ul>
      </div>

      <!-- Community -->
      <div>
        <h4 class="font-display font-semibold text-sm mb-3">{t('footer.community')}</h4>
        <ul class="space-y-2 text-sm text-base-content/50">
          <li><a href="https://github.com/joshuacba08/oroya-animate" target="_blank" rel="noopener" class="hover:text-base-content transition-colors">GitHub</a></li>
          <li><a href="https://github.com/joshuacba08/oroya-animate/issues" target="_blank" rel="noopener" class="hover:text-base-content transition-colors">{t('footer.issues')}</a></li>
          <li><a href={getLocalizedPath("/docs/contributing", locale)} class="hover:text-base-content transition-colors">{t('footer.contributing')}</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-base-300/30 mt-8 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-base-content/40">
        &copy; {currentYear} Oroya Animate. MIT License.
      </p>
      <p class="text-xs text-base-content/30">
        Built with <a href="https://astro.build" target="_blank" rel="noopener" class="hover:text-base-content/60 transition-colors">Astro</a>,
        <a href="https://tailwindcss.com" target="_blank" rel="noopener" class="hover:text-base-content/60 transition-colors">Tailwind CSS</a>
        & <a href="https://daisyui.com" target="_blank" rel="noopener" class="hover:text-base-content/60 transition-colors">daisyUI</a>
      </p>
    </div>
  </div>
</footer>
