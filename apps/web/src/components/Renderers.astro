---
import HeroDemoWrapper from "./HeroDemoWrapper";
---

<section id="renderers" class="py-24 px-6">
  <div class="container mx-auto max-w-6xl">
    <!-- Section header -->
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold font-display mb-4 tracking-tight">
        One Scene Graph, <span class="text-gradient">Multiple Renderers</span>
      </h2>
      <p class="text-base-content/60 max-w-2xl mx-auto text-lg">
        Write your scene logic once. Render with Three.js for immersive 3D WebGL
        experiences, or SVG for lightweight, scalable 2D vector graphics.
      </p>
    </div>

    <!-- Live Three.js demo — full width -->
    <div class="mb-12">
      <div class="glass-card rounded-2xl overflow-hidden">
        <!-- Browser-like header -->
        <div class="flex items-center gap-2 px-4 py-2.5 border-b border-base-300/50">
          <div class="w-2.5 h-2.5 rounded-full bg-error/50"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-warning/50"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-success/50"></div>
          <span class="text-xs text-base-content/30 ml-2 font-mono">
            ThreeRenderer — HelloCube scene
          </span>
          <span class="badge badge-primary badge-xs ml-auto font-mono">LIVE</span>
        </div>
        <!-- Three.js canvas island — client:only skips SSR entirely -->
        <HeroDemoWrapper client:only="react" />
      </div>
    </div>

    <!-- Renderer comparison cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Three.js card -->
      <div class="glass-card rounded-2xl overflow-hidden group p-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-lg bg-purple-600/20 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple-400">
              <path d="m21 16-4 4-4-4"/><path d="M17 20V4"/><path d="m3 8 4-4 4 4"/><path d="M7 4v16"/>
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-display font-semibold flex items-center gap-2">
              Three.js Renderer
              <span class="badge badge-primary badge-xs font-mono">WebGL</span>
            </h3>
            <p class="text-xs text-base-content/40">@oroya/renderer-three</p>
          </div>
        </div>
        <p class="text-base-content/60 text-sm leading-relaxed mb-4">
          Full 3D rendering powered by Three.js and WebGL. Support for perspective
          and orthographic cameras, PBR materials, glTF model loading, and real-time
          interaction events.
        </p>
        <div class="flex flex-wrap gap-2">
          <span class="badge badge-outline badge-xs">Perspective Camera</span>
          <span class="badge badge-outline badge-xs">Materials</span>
          <span class="badge badge-outline badge-xs">glTF Loading</span>
          <span class="badge badge-outline badge-xs">Interaction Events</span>
        </div>
      </div>

      <!-- SVG card -->
      <div class="glass-card rounded-2xl overflow-hidden group p-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-lg bg-cyan-600/20 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-cyan-400">
              <path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
              <path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"/>
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-display font-semibold flex items-center gap-2">
              SVG Renderer
              <span class="badge badge-accent badge-xs font-mono">Vector</span>
            </h3>
            <p class="text-xs text-base-content/40">@oroya/renderer-svg</p>
          </div>
        </div>
        <p class="text-base-content/60 text-sm leading-relaxed mb-4">
          Lightweight vector graphics rendering. Perfect for generative art,
          data visualization, interactive diagrams, and resolution-independent
          graphics with CSS styling support.
        </p>
        <div class="flex flex-wrap gap-2">
          <span class="badge badge-outline badge-xs">Path2D</span>
          <span class="badge badge-outline badge-xs">Gradients</span>
          <span class="badge badge-outline badge-xs">Filters</span>
          <span class="badge badge-outline badge-xs">Animations</span>
          <span class="badge badge-outline badge-xs">Interactive</span>
        </div>
      </div>
    </div>

    <!-- Same code, different output -->
    <div class="mt-12 text-center">
      <div class="inline-flex items-center gap-3 glass-card rounded-full px-6 py-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
          <path d="m5 12 7-7 7 7"/>
          <path d="M12 19V5"/>
        </svg>
        <span class="text-sm text-base-content/70">
          Same scene graph — just swap the renderer
        </span>
      </div>
    </div>
  </div>
</section>
